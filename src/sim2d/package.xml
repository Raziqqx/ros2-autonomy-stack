<?xml version="1.0"?>
<package format="3">
  <name>sim2d</name>
  <version>0.1.0</version>
  <description>Lightweight 2D differential-drive simulator: raycast LiDAR, noisy odometry and IMU, ground truth.</description>
  <maintainer email="dev@example.com">portfolio</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>grid_core</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
