<?xml version="1.0"?>
<package format="3">
  <name>ekf_localization</name>
  <version>0.1.0</version>
  <description>EKF localisation node: wheel odometry + IMU yaw, corrected by ICP scan matching against a prior map.</description>
  <maintainer email="dev@example.com">portfolio</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ekf_core</depend>
  <depend>icp_core</depend>
  <depend>grid_core</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
